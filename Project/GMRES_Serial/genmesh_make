# Compiler
CC = gcc

# Compiler flags
CFLAGS = -Wall -O2 -std=c11

# Target executable
TARGET = genmesh

# Source files
SRCS = genmesh_main.c mesh.c field.c io.c vtk.c

# Object files
OBJS = $(SRCS:.c=.o)

# Default target
all: $(TARGET)

# Link step
$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^

# Compile step
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Clean build files
clean:
	rm -f $(OBJS) $(TARGET)

# Phony targets
.PHONY: all clean